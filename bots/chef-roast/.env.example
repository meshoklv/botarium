# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter key (recipe + roast generation) - https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# SQLite file with users and preferences
DB_PATH=./data/database.db

# Default tone of the bot (see src/utils/insults.js for the available modes)
INSULT_MODE=standard   # light | standard | ramsey
BOT_NAME=Гастро-ублюдок
