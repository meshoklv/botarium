# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter key (LLM that runs the dialogue) - https://openrouter.ai
OUTER_API_KEY=
AI_MODEL=deepseek/deepseek-chat-v3.1

# Groq key (Whisper speech-to-text for voice messages) - https://console.groq.com
GROQ_API_KEY=

# Salon branding shown to clients
SALON_NAME=Nail Studio
SALON_ADDRESS=ул. Пушкина, д. 10
