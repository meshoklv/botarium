# Telegram bot token from @BotFather
HEALTH_BOT_TOKEN=
# Your own numeric Telegram id - the bot only talks to this chat
CHAT_ID=

# Analysis backend: "cli" (local `claude` CLI) or "api" (needs ANTHROPIC_API_KEY)
ANALYZER=api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CLAUDE_MODEL=sonnet

# Who the report is about (free text; the model adapts the norms to it)
USER_PROFILE=Adult, 30 years old, 175 cm, 70 kg.

# Phone sync over SSH (optional): alias from ~/.ssh/config pointing to Termux sshd
PHONE_SSH_HOST=phone
# Or skip the phone entirely: put an exported Gadgetbridge.db at data/gadgetbridge.db
