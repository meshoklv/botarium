# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter key (parses requests, writes the insults) - https://openrouter.ai
OUTER_API_KEY=
AI_MODEL=deepseek/deepseek-chat-v3.1

# Groq key (Whisper speech-to-text for voice messages) - https://console.groq.com
GROQ_API_KEY=

# Fallback IANA timezone used until a user sets their own city
REMINDER_TIMEZONE=UTC
