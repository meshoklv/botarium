# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# kie.ai API key (Nano Banana image generation / editing) - https://kie.ai
KIE_API_KEY=
KIE_API_URL=https://api.kie.ai

# Your numeric Telegram id: unlocks the admin panel (stats, grant subscriptions, broadcast)
ADMIN_USER_ID=
# Support username (without @) shown to users who hit the daily limit
ADMIN_CONTACT_USERNAME=your_support_username

# Daily generation limits per tier
DAILY_LIMIT_FREE=5
DAILY_LIMIT_PLUS=15
DAILY_LIMIT_ULTRA=40

DEFAULT_ASPECT_RATIO=1:1
MAX_IMAGE_SIZE_MB=10
GENERATION_TIMEOUT_SECONDS=120
TIMEZONE=UTC
# Show invented numbers in the admin stats screen (demo only)
USE_FAKE_STATS=false
# Comma-separated user ids that receive test broadcasts
TEST_USER_IDS=
