# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# PostgreSQL. With docker-compose the bundled Postgres is used automatically.
# Without Docker: any Postgres (Supabase, Neon, local). Apply sql/*.sql in order first.
# With docker-compose DATABASE_URL is set automatically (bundled Postgres). Without Docker, point it at any Postgres:
DATABASE_URL=postgresql://taskflow:change-me@localhost:5432/taskflow

# OpenRouter key (text cleanup after speech recognition, AI task analysis) - https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Local speech recognition (whisper.cpp) - the Docker image builds both of these
# WHISPER_CLI_PATH=./whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=./models/ggml-base.bin

# Optional: design-team "orders" mode for these Telegram ids (comma-separated). Empty = plain task manager.
TEAM_USER_IDS=
TEAM_NAME=Design Team
