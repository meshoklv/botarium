# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter key (LLM that writes the summaries) - https://openrouter.ai
OUTER_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# Groq key (Whisper speech-to-text) - https://console.groq.com
GROQ_API_KEY=

# Optional: comma-separated Telegram user ids allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=
